{
  "name": "popintent",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Chromium extension that blocks unexpected popup navigations.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test",
    "package": "pnpm build && pnpm verify:dist && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.7",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
